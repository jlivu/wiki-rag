# Production settings. Copy to deploy/.env.prod, which is gitignored.
#
#   cp deploy/.env.prod.example deploy/.env.prod
#
# Then put the secrets in without them appearing on screen or in your
# shell history — see "Secrets" in deploy/README.md. Never paste a key on
# a command line.

# ── where it listens ────────────────────────────────────────────────
# Published on 127.0.0.1 only, by docker-compose.prod.yml.
PROD_PORT=8088

# ── images ──────────────────────────────────────────────────────────
# Built by deploy/build.sh, which also tags a dated version you can roll
# back to.
WIKI_IMAGE=wiki-rag/wiki:latest
AI_IMAGE=wiki-rag/ai:latest

# ── the wiki's database ─────────────────────────────────────────────
# These must match the database in WIKI_DB_VOLUME. For the installed
# wiki's volume that means the user and password it was created with.
WIKI_DB_NAME=wiki
WIKI_DB_USER=wikijs
WIKI_DB_PASS=

# The Docker volumes production uses. The defaults are the installed
# wiki's own, so production continues with the pages and files already
# there. Point them at copies to rehearse without touching the original.
WIKI_DB_VOLUME=wikijs_db-data
WIKI_DATA_VOLUME=wikijs_wiki-data

# ── the index ───────────────────────────────────────────────────────
# Ours alone, created on first start, and rebuildable from the wiki.
INDEX_DB_NAME=wiki_ai
INDEX_DB_USER=wiki_ai
INDEX_DB_PASS=
INDEX_DB_VOLUME=wiki-rag-prod-index

# ── the answering model ─────────────────────────────────────────────
# Local models only: the server runs the search and reads the pages
# itself, and the model answers in one turn. Measured 2026-10-28 — it
# halves the median wait and cuts the worst case from 24 minutes to a
# minute, because what the small models get wrong is the tool loop, not
# the answer. Cloud models ignore it and keep the loop.
OLLAMA_RETRIEVE_FIRST=1

# ANTHROPIC_API_KEY is the same key development uses. Copy the line
# across rather than typing it, so the value is never on screen:
#
#   grep '^ANTHROPIC_API_KEY=' ai/.env >> deploy/.env.prod
#
LLM_PROVIDER=anthropic
LLM_MODEL=claude-sonnet-5-5
ANTHROPIC_API_KEY=
MAX_TOOL_STEPS=6
MAX_OUTPUT_TOKENS=8192
LLM_EFFORT=medium
LLM_PROMPT_CACHE=true

# ── the index and the wiki ──────────────────────────────────────────
# Where a person opens the wiki. It is what the assistant's citations
# link to, so it has to be the address you actually use.
WIKI_PUBLIC_URL=http://localhost:8088

# Reads page source as an administrator, for the indexer. Make a new key
# in Admin > API for production; do not reuse the development one.
WIKI_API_KEY=

EMBED_MODEL=nomic-embed-text
INDEX_DEBOUNCE_SECONDS=10
RECONCILE_MINUTES=30
WIKI_LOCALE=en

# ── documents and images ────────────────────────────────────────────
MAX_DOCUMENT_MB=25
WIKI_PAGE_EXTENSIONS=md,html,txt
IMAGE_DESCRIBER=anthropic
IMAGE_DESCRIBER_MODEL=claude-haiku-5-5
IMAGE_DESCRIBE_EXCLUDE=
IMAGE_DESCRIBE_DAILY_LIMIT=200

# ── dictation ───────────────────────────────────────────────────────
# whisper.cpp runs natively on the Mac, shared with development.
STT_PROVIDER=whispercpp
STT_LANGUAGE=en
# Which whisper model the launch agent loads, declared rather than
# detected. Changing it tells the index to read every transcribed video
# again — see "When a model changes under the index" in ai/README.md.
STT_MODEL=ggml-small.en
STT_MAX_SECONDS=120
STT_RATE_LIMIT_PER_MINUTE=20

# ── MCP, for agents such as Claude Code ─────────────────────────────
MCP_RATE_LIMIT_PER_MINUTE=60
MCP_ALLOWED_HOSTS=localhost:8088,127.0.0.1:8088,ai:4000
MCP_ALLOWED_ORIGINS=http://localhost:8088,http://127.0.0.1:8088

# ── logging ─────────────────────────────────────────────────────────
LOG_LEVEL=info
