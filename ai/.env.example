# Copy to ai/.env (gitignored) and fill in. Never commit ai/.env.

# ── Which models answer ─────────────────────────────────────────────
#
# MODELS is the whole story once you set it. It lists every model a
# reader may pick from the menu under the message box, in the order the
# menu shows them, written as provider:model. **The first entry is the
# default** — the model the panel starts on for a reader who has not
# chosen. Anything not on this list is refused by the server, whatever
# the browser sends.
#
# With MODELS set:
#   LLM_MODEL    is ignored. MODELS' first entry is the default.
#   LLM_PROVIDER is not needed. The provider comes from each entry.
#                The one thing it still does is LLM_PROVIDER=mock, which
#                overrides MODELS entirely (see below).
#
# With MODELS unset, the older two lines still work: LLM_PROVIDER picks
# the provider, LLM_MODEL the default model, and the menu offers the
# built-in list with that model moved to the front.
#
# Every model the service supports, default first. Uncomment the line
# you want; a model may be left out, and the order is yours.
MODELS=anthropic:claude-sonnet-5-5,anthropic:claude-haiku-5-5,ollama:gemma4:e4b
#
#   anthropic:claude-sonnet-5-5   Balanced. The default, and the one the
#                                 measurements in ai/README.md are against.
#   anthropic:claude-haiku-5-5    About twelve times cheaper and as quick,
#                                 but it over-draws the cards below Extra
#                                 high effort.
#   anthropic:claude-opus-5-5     Supported, and deliberately not in the
#                                 line above — see "Is Opus worth it here"
#                                 in ai/README.md before adding it.
#   ollama:gemma4:e4b             Private: nothing leaves this Mac. Slower,
#                                 and it misses cards about half the time.
#   ollama:<any pulled model>     Anything Ollama has with the `tools`
#                                 capability (`ollama show <model>`).
#                                 qwen3.5 was measured and is not
#                                 recommended; see the README.
#
# A local model is listed whether or not Ollama is running: the menu shows
# it greyed out with the reason. To offer cloud models only, drop the
# ollama: entries.

# Only needed when MODELS is unset — or set to "mock", which overrides
# MODELS and keeps the canned keyword replies from step 2, for working on
# the panel with no model calls and no cost: anthropic | ollama | mock.
LLM_PROVIDER=anthropic

# Only read when MODELS is unset: the model the panel starts on.
LLM_MODEL=claude-sonnet-5-5

# Required when answering with Anthropic. Keep it out of the repository.
ANTHROPIC_API_KEY=

# Ollama runs natively on the Mac, so containers reach it through the host.
OLLAMA_URL=http://host.docker.internal:11434

# Optional. Let a local model think at all. On, because the local models
# worth offering need it to call a tool properly — off is two to five
# times faster and much worse. Set to 0 to force thinking off whatever
# effort a reader picks. Ollama only.
OLLAMA_THINKING=1

# How many rounds of wiki tool calls one answer may take before the agent
# has to reply with what it has.
MAX_TOOL_STEPS=6

# Ceiling for one reply. Thinking counts towards this on current Claude
# models, so leave headroom.
MAX_OUTPUT_TOKENS=8192

# ── How hard the model works ────────────────────────────────────────
#
# LLM_EFFORT is the level a reader gets before they choose one, and the
# level the menu marks "Recommended". It applies to every model that has
# that level; one that does not — a local model only has low and high —
# falls back to its own default. The reader's own choice is remembered
# per model in their browser and overrides this.
#
# Anthropic sets this with output_config.effort, and every current Claude
# model takes all five levels. Ollama has no such scale, only thinking on
# or off, so a local model is offered low (thinking off) and high
# (thinking on) and nothing in between.
#
# low | medium | high | xhigh | max
LLM_EFFORT=medium

# Optional. Which levels the menu may offer at all, applied on top of
# what each model supports and enforced by the server: a run asking for
# a level outside this list is refused, not quietly rounded. Unset means
# every level the model has, which is the default.
#
#   EFFORTS=low,medium,high     hide the two dearest levels
#   EFFORTS=medium              no choice at all; the row disappears
#
# LLM_EFFORT has to be one of these, or the service refuses to start. If
# the list leaves a model with nothing, that model simply has no Effort
# row and runs at its own default.
EFFORTS=

# Optional. Give up on a model that has stopped responding, in milliseconds.
LLM_TIMEOUT_MS=120000

# Optional. Where Wiki.js answers, from inside the Docker network.
WIKI_URL=http://wiki-app:3000

# Optional. Fastify log level: trace | debug | info | warn | error.
LOG_LEVEL=info

# ── The page index (step 3b) ────────────────────────────────────────

# Reads page source through Wiki.js GraphQL as an administrator, which the
# indexer needs and a reader's token cannot do. Create one in
# Admin > API, enable the API, and paste the key here. Without it the
# indexer stays switched off. Keep it out of the repository.
WIKI_API_KEY=

# The embedding model, pulled in Ollama on the Mac (`ollama pull <model>`).
# Changing it re-embeds every page.
EMBED_MODEL=nomic-embed-text

# Rapid saves of the same page collapse into one job after this long.
INDEX_DEBOUNCE_SECONDS=10

# How often the index is compared with Wiki.js's page list.
RECONCILE_MINUTES=30

# Optional. The index database; the default matches the ai-db service in
# dev/containers/docker-compose.ai.yml.
INDEX_DB_URL=postgres://wiki_ai:wiki_ai@ai-db:5432/wiki_ai

# ── Uploaded documents ──────────────────────────────────────────────

# Files larger than this are listed in the index as skipped, with the
# reason, and never downloaded. Note that Wiki.js has its own, usually
# smaller, upload limit in Admin > General.
MAX_DOCUMENT_MB=25

# Wiki.js's own pageExtensions setting (Admin > General). Wiki.js serves a
# URL ending in one of these as a page, so an uploaded file with that
# extension can be neither downloaded nor permission-checked: such files
# are listed as skipped rather than indexed. Change this only if the wiki's
# setting is changed.
WIKI_PAGE_EXTENSIONS=md,html,txt

# ── Images ──────────────────────────────────────────────────────────

# Which model describes an image, on top of the text OCR reads in it and
# the alt text the wiki pages give it: anthropic (default), ollama or off.
# With no ANTHROPIC_API_KEY, anthropic falls back to off.
IMAGE_DESCRIBER=anthropic

# The vision model. Default claude-haiku-5-5 for anthropic, qwen3.5 for
# ollama. Only this model ever sees an image, and only after its metadata
# has been stripped and it has been resized.
IMAGE_DESCRIBER_MODEL=claude-haiku-5-5

# Asset folders whose images are never sent to any model, by path prefix,
# comma separated. OCR and alt text still apply to them.
IMAGE_DESCRIBE_EXCLUDE=

# How many images a day may be described. The count is kept in the index,
# so a restart does not reset it.
IMAGE_DESCRIBE_DAILY_LIMIT=200

# ── Videos ──────────────────────────────────────────────────────────

# Videos live in a folder on this Mac, not in Wiki.js's database: Wiki.js
# loads a whole asset into memory the first time it is asked for, so a
# recording could not be seeked, and the nightly dump would carry every
# video fourteen times over. docker-compose mounts the Mac's folder
# read-only at /media; set MEDIA_HOST_DIR in the shell or in the compose
# file to point somewhere else (development ~/Media/wiki-dev, production
# ~/Media/wiki). An unmounted folder simply switches videos off.
MEDIA_DIR=/media

# How often the folder is swept, in seconds. It is also watched, so a
# file dropped in is usually noticed within a couple of seconds; the
# sweep is what catches anything the watch missed.
MEDIA_SCAN_SECONDS=30

# A file has to stop changing for this long before it is read, so a video
# still being copied in is not indexed half-written.
MEDIA_SETTLE_SECONDS=20

# A recording longer than this is recorded as skipped rather than read.
VIDEO_MAX_MINUTES=240

# Roughly how long one chunk of a recording covers, in seconds. A citation
# sends the reader to the start of a chunk, so this is how close it gets.
VIDEO_CHUNK_SECONDS=90

# The audio is transcribed a window at a time, cut at a pause, so a long
# recording is not one huge upload and a reader dictating into the panel
# does not wait behind it. whisper's own sentence times place each line
# within the window; this only has to be small enough to keep the Mac
# responsive — and small enough to matter if whisper-server is ever
# started with --no-timestamps, which it should not be (ai/README.md).
VIDEO_SPEECH_WINDOW_SECONDS=30

# Read the text on screen with Tesseract. Frames are taken at every scene
# change and at least every VIDEO_FRAME_SECONDS.
VIDEO_OCR=1
VIDEO_FRAME_SECONDS=30

# How much of the picture has to change before it counts as a new scene,
# from 0 to 1. Lower takes more frames.
VIDEO_SCENE_THRESHOLD=0.3

# Frames read from one recording, at most.
VIDEO_MAX_FRAMES=400

# Ask a vision model what a frame shows, on top of the text read from it.
# Off by default: a recording is hundreds of frames and this is the only
# part of video indexing that is not free. When on it follows
# IMAGE_DESCRIBER, IMAGE_DESCRIBE_EXCLUDE and IMAGE_DESCRIBE_DAILY_LIMIT.
VIDEO_DESCRIBE=0

# Frames of any one recording that may be described, spread across it.
VIDEO_DESCRIBE_FRAME_CAP=6

# ── Dictation (speech to text) ──────────────────────────────────────

# whispercpp (the default) or off. Off hides the microphone button in the
# panel; so does whisper-server not answering, so a half-finished setup
# never shows a button that cannot work.
# whisper.cpp runs natively on the Mac so it can use the GPU, like Ollama;
# see ai/README.md for the install and the launch agent.
STT_PROVIDER=whispercpp

# Where whisper-server listens. Containers reach the Mac through the host.
STT_URL=http://host.docker.internal:8178

# The language spoken. 'auto' lets Whisper detect it, less accurately.
STT_LANGUAGE=en

# A recording longer than this is refused, and the panel stops recording
# by itself when it is reached.
STT_MAX_SECONDS=120

# Recordings allowed per reader per minute.
STT_RATE_LIMIT_PER_MINUTE=20

# ── The MCP server for agents (step 3c) ─────────────────────────────

# Where a person opens the wiki. Used for the page URLs agents cite, so it
# has to be the address a human can click, not the Docker network one.
WIKI_PUBLIC_URL=http://127.0.0.1:3080

# Tool calls allowed per API key per minute.
MCP_RATE_LIMIT_PER_MINUTE=60

# DNS rebinding protection. A request whose Host is not listed is refused;
# so is one whose Origin is set and not listed. Agents send no Origin, so
# that check only bites browsers.
MCP_ALLOWED_HOSTS=127.0.0.1:3080,localhost:3080,ai:4000
MCP_ALLOWED_ORIGINS=http://127.0.0.1:3080,http://localhost:3080

# Optional. The wiki's own locale, used when a caller does not say.
WIKI_LOCALE=en
