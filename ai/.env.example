# Copy to ai/.env (gitignored) and fill in. Never commit ai/.env.

# Which model provider answers questions: anthropic | ollama | mock.
# "mock" keeps the canned keyword replies from step 2, for UI work with no
# model calls and no cost.
LLM_PROVIDER=anthropic

# The model to use with the chosen provider. Defaults per provider:
#   anthropic  claude-sonnet-5-5   (cheaper: claude-haiku-5-5)
#   ollama     qwen3.5             (any locally pulled model that has tools)
LLM_MODEL=claude-sonnet-5-5

# Required when LLM_PROVIDER=anthropic. Keep it out of the repository.
ANTHROPIC_API_KEY=

# Ollama runs natively on the Mac, so containers reach it through the host.
OLLAMA_URL=http://host.docker.internal:11434

# How many rounds of wiki tool calls one answer may take before the agent
# has to reply with what it has.
MAX_TOOL_STEPS=6

# Ceiling for one reply. Thinking counts towards this on current Claude
# models, so leave headroom.
MAX_OUTPUT_TOKENS=8192

# Optional. How hard the model thinks: low | medium | high | xhigh | max.
# Anthropic only; higher costs more and takes longer.
LLM_EFFORT=medium

# Optional. Give up on a model that has stopped responding, in milliseconds.
LLM_TIMEOUT_MS=120000

# Optional. Where Wiki.js answers, from inside the Docker network.
WIKI_URL=http://wiki-app:3000

# Optional. Fastify log level: trace | debug | info | warn | error.
LOG_LEVEL=info

# ── The page index (step 3b) ────────────────────────────────────────

# Reads page source through Wiki.js GraphQL as an administrator, which the
# indexer needs and a reader's token cannot do. Create one in
# Admin > API, enable the API, and paste the key here. Without it the
# indexer stays switched off. Keep it out of the repository.
WIKI_API_KEY=

# The embedding model, pulled in Ollama on the Mac (`ollama pull <model>`).
# Changing it re-embeds every page.
EMBED_MODEL=nomic-embed-text

# Rapid saves of the same page collapse into one job after this long.
INDEX_DEBOUNCE_SECONDS=10

# How often the index is compared with Wiki.js's page list.
RECONCILE_MINUTES=30

# Optional. The index database; the default matches the ai-db service in
# dev/containers/docker-compose.ai.yml.
INDEX_DB_URL=postgres://wiki_ai:wiki_ai@ai-db:5432/wiki_ai

# ── Uploaded documents ──────────────────────────────────────────────

# Files larger than this are listed in the index as skipped, with the
# reason, and never downloaded. Note that Wiki.js has its own, usually
# smaller, upload limit in Admin > General.
MAX_DOCUMENT_MB=25

# Wiki.js's own pageExtensions setting (Admin > General). Wiki.js serves a
# URL ending in one of these as a page, so an uploaded file with that
# extension can be neither downloaded nor permission-checked: such files
# are listed as skipped rather than indexed. Change this only if the wiki's
# setting is changed.
WIKI_PAGE_EXTENSIONS=md,html,txt

# ── The MCP server for agents (step 3c) ─────────────────────────────

# Where a person opens the wiki. Used for the page URLs agents cite, so it
# has to be the address a human can click, not the Docker network one.
WIKI_PUBLIC_URL=http://127.0.0.1:3080

# Tool calls allowed per API key per minute.
MCP_RATE_LIMIT_PER_MINUTE=60

# DNS rebinding protection. A request whose Host is not listed is refused;
# so is one whose Origin is set and not listed. Agents send no Origin, so
# that check only bites browsers.
MCP_ALLOWED_HOSTS=127.0.0.1:3080,localhost:3080,ai:4000
MCP_ALLOWED_ORIGINS=http://127.0.0.1:3080,http://localhost:3080

# Optional. The wiki's own locale, used when a caller does not say.
WIKI_LOCALE=en
